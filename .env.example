# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the resulting .env file.

# --- Postgres (db service) ---
POSTGRES_USER=personfin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=personfin

# --- Backend (backend/app/config.py Settings) ---

# SQLAlchemy connection string; host must be the compose service name "db".
DATABASE_URL=postgresql://personfin:changeme@db:5432/personfin
# Secret key used to sign/verify JWTs issued by the backend.
JWT_SECRET=changeme
# Google OAuth client ID used for Sign in with Google.
GOOGLE_CLIENT_ID=changeme
# Google OAuth client secret paired with GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_SECRET=changeme
# API key for the foreign-exchange rate provider (optional feature).
FX_API_KEY=
# In-container path where uploaded screenshots are stored; must match the
# "uploads" volume mount point in docker-compose.yml.
UPLOAD_DIR=/data/uploads
# Base URL of the Azure OpenAI resource used for screenshot extraction.
AZURE_OPENAI_ENDPOINT=https://changeme.openai.azure.com/
# API key for the Azure OpenAI resource.
AZURE_OPENAI_API_KEY=changeme
# Deployment name of the Azure OpenAI model to call.
AZURE_OPENAI_DEPLOYMENT=changeme
# API key for DeepSeek, used for optional insight narration.
DEEPSEEK_API_KEY=
